<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <EditText
        android:id="@+id/edit_title_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:background="@color/titleBarBlue"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingLeft="10dp"
        android:paddingEnd="10dp"
        android:paddingRight="10dp"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:inputType="textNoSuggestions"
        android:selectAllOnFocus="true"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/layout_middle_controls"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageButton
            android:id="@+id/button_prev_frame"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Seek to start"
            android:src="@drawable/skip_previous_24px"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/button_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play"
            android:src="@drawable/play_arrow_24px"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/button_crop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle crop"
            android:src="@drawable/crop_24px"
            android:tint="@android:color/white" />
    </LinearLayout>

    <include
        android:id="@+id/layout_timeline_container"
        layout="@layout/editor_timeline"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/layout_middle_controls"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp" />

    <include
        layout="@layout/editor_time_labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/layout_timeline_container"
        android:layout_alignStart="@+id/layout_timeline_container" />

    <FrameLayout
        android:id="@+id/layout_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_time_labels"
        android:layout_below="@id/edit_title_bar"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp">

        <TextureView
            android:id="@+id/texture_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <com.videocutter.CropOverlayView
            android:id="@+id/crop_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/button_cancel_action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_below="@id/edit_title_bar"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:elevation="4dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/arrow_back_24px"
        android:tint="#808080" />

    <ImageButton
        android:id="@+id/button_reset_trim"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_below="@id/edit_title_bar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Reset trim"
        android:elevation="4dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/replay_24px"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/button_save_check"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/edit_title_bar"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Export"
        android:elevation="4dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/save_24px"
        android:tint="@android:color/white" />

    <include layout="@layout/editor_overlays" />

</RelativeLayout>
