<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="8dp">

    <RelativeLayout
        android:id="@+id/item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:clickable="true">

        <ImageView
            android:id="@+id/image_album_art"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/vide_shadow"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_album_art" />

        <FrameLayout
            android:id="@+id/layout_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageButton
                android:id="@+id/button_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:src="@drawable/delete_24px"
                android:tint="@color/gmaRed"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_remove_video" />

            <ImageButton
                android:id="@+id/button_save_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:visibility="gone"
                android:src="@drawable/save_24px"
                android:tint="@color/gmaGreenDarkMono"
                android:background="@android:color/transparent"
                android:contentDescription="Save Changes" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layout_text_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/image_album_art"
            android:layout_toStartOf="@id/layout_buttons"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/titleColor"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/subtitleColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#808080"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/edit_text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:textColor="@color/titleColor"
                android:textSize="14sp" />
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
